{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokeroledex",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  // PR previews keep user records in a separate database. Rulebook resources are read-only.
  "previews": {
    "vars": {
      "ACCESS_TEAM_DOMAIN": "lopiparo.cloudflareaccess.com",
      "ACCESS_AUD": "ec4b8591ea568bd903227125b7b4b2388e104194cc6cfdf0bb87926677b358b2",
      "GITHUB_REPO": "Pippobaudoicon/pokeroledex"
    },
    "d1_databases": [
      { "binding": "DB", "database_name": "pokeroledex-preview", "database_id": "1245dcf9-4027-4691-bb80-3bfaedebad4c", "migrations_dir": "migrations" }
    ],
    "r2_buckets": [{ "binding": "RULEBOOK", "bucket_name": "pokeroledex-rulebook" }],
    "ai_search": [{ "binding": "RULEBOOK_SEARCH", "instance_name": "pokeroledex-corebook", "remote": true }]
  },
  "routes": [{ "pattern": "pokeroledex.tommasolopiparo.com", "custom_domain": true }],
  "assets": {
    // Files are served first. Requests that match no file go to the Worker, which
    // handles the BoxSprites fallback, 404s and the SPA index.html (worker/index.ts).
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Access login in front of the site (worker/access.ts, README "Logins").
  "vars": { "ACCESS_TEAM_DOMAIN": "lopiparo.cloudflareaccess.com", "ACCESS_AUD": "5fc1b34303394c0b49f06f3cef919a5c7eab1bb4a036d943f0dc6f43ae6bec7f",
    // Issue reports (worker/github.ts). The token is a secret: `wrangler secret put GITHUB_TOKEN`.
    "GITHUB_REPO": "Pippobaudoicon/pokeroledex" },
  // The Pokérole corebook and its text (worker/index.ts, scripts/upload-rulebook.ts).
  "r2_buckets": [{ "binding": "RULEBOOK", "bucket_name": "pokeroledex-rulebook" }],
  // "Ask the rulebook" (worker/ask.ts). Local dev needs the real instance.
  "ai_search": [{ "binding": "RULEBOOK_SEARCH", "instance_name": "pokeroledex-corebook", "remote": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "pokeroledex", "database_id": "a7adefee-6890-46f2-bc0c-bcdada772e0e", "migrations_dir": "migrations" }
  ]
}
