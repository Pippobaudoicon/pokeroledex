{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokeroledex",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "routes": [{ "pattern": "pokeroledex.tommasolopiparo.com", "custom_domain": true }],
  "assets": {
    // Files are served first. Requests that match no file go to the Worker, which
    // handles the BoxSprites fallback, 404s and the SPA index.html (worker/index.ts).
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Access login in front of the site (worker/access.ts, README "Logins").
  "vars": { "ACCESS_TEAM_DOMAIN": "lopiparo.cloudflareaccess.com", "ACCESS_AUD": "5fc1b34303394c0b49f06f3cef919a5c7eab1bb4a036d943f0dc6f43ae6bec7f" },
  "d1_databases": [
    { "binding": "DB", "database_name": "pokeroledex", "database_id": "a7adefee-6890-46f2-bc0c-bcdada772e0e", "migrations_dir": "migrations" }
  ]
}
