{
  "name": "pokeroledex",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "description": "PokéroleDex recovery as a React + TypeScript app on Cloudflare Workers",
  "scripts": {
    "dev": "node scripts/build-reference.ts && wrangler d1 migrations apply pokeroledex --local && vite",
    "dev:offline": "pnpm dev --mode offline",
    "build": "node scripts/build-reference.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "deploy": "pnpm build && wrangler d1 migrations apply pokeroledex --remote && wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.0.4",
    "@radix-ui/react-collapsible": "1.0.3",
    "@radix-ui/react-dialog": "1.0.5",
    "@radix-ui/react-popover": "1.0.7",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-separator": "1.0.3",
    "@radix-ui/react-slot": "1.0.2",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.1.5",
    "@radix-ui/react-tooltip": "1.0.7",
    "@tanstack/react-query": "5.22.2",
    "@uidotdev/usehooks": "2.4.1",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.0",
    "cmdk": "0.2.1",
    "lucide-react": "0.335.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "5.0.1",
    "react-joyride": "2.9.3",
    "react-router-dom": "6.22.1",
    "react-textfit": "1.1.1",
    "tailwind-merge": "2.2.1",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "5.20260919.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-textfit": "1.1.4",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
